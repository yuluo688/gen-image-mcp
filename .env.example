# 必填：OpenAI 兼容代理根 URL（完整 HTTP/HTTPS，无内置默认）
GEN_IMAGE_BASE_URL=
# 必填：Bearer API Key（非空）
GEN_IMAGE_API_KEY=

# Images 与 Gemini 两组至少配置一组（逗号分隔多模型；顺序即失败切换顺序）
# GEN_IMAGE_MODEL=gpt-image-2,other-images-model
# GEN_IMAGE_GEMINI_MODEL=gemini-2.5-flash-image,other-gemini-image-model

# 可选：上游失败时按序切换下一模型（true|false，默认 false）
# GEN_IMAGE_AUTO_FALLBACK=false

# 可选：HTTP 超时毫秒（默认 120000；显式无效值报错）
# GEN_IMAGE_TIMEOUT_MS=120000
