{
  "name": "gen-image-mcp",
  "version": "0.1.0",
  "description": "stdio MCP server for OpenAI Images API and Gemini chat image generation",
  "type": "module",
  "bin": {
    "gen-image-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
